# Grok API key for ASR refinement + language intelligence (Member 2)
# Get yours at https://console.x.ai/
#GROK_API_KEY=your_api_key_here
# Alias also accepted:
# XAI_API_KEY=your_grok_api_key_here

# Flask settings (optional overrides)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False