# ── ECHO Environment Variables ────────────────────────────────────────────────

# Gemini 2.5 Flash API Key (for transcription, language detection, emotion, intent)
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace token for pyannote.audio speaker diarization
# Get yours at https://huggingface.co/settings/tokens
# Also accept the model terms at https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=ur key

MONGODB_URI=url

# Flask settings (optional overrides)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# ── Twilio Helpline Integration (optional) ────────────────────────────────────
# pip install twilio
# Get credentials at https://console.twilio.com (free $15.50 trial credit)
# WhatsApp Sandbox: Console → Messaging → Try it out → Send a WhatsApp message
# Each recipient must send "join <code>" to the sandbox number on WhatsApp first

TWILIO_ACCOUNT_SID=urs
TWILIO_AUTH_TOKEN=urs

# Use the WhatsApp Sandbox number from Twilio console (prefix with whatsapp:)
TWILIO_FROM_NUMBER=urs

# Your helpline WhatsApp numbers (must have joined the sandbox)
HELPLINE_POLICE=urs
HELPLINE_AMBULANCE=urs

